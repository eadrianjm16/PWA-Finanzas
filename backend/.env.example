# Copia este archivo a .env y completa los valores.

# --- Base de datos ---
# Dev local: sqlite:///./finanzas.db
# Produccion: usa una URL persistente (ver README.md, seccion "Base de datos en
# produccion") - el disco de los planes gratuitos de Render/Railway es efimero.
DATABASE_URL=sqlite:///./finanzas.db

# --- Enable Banking (https://enablebanking.com, panel de control) ---
EB_APPLICATION_ID=PON-AQUI-TU-APPLICATION-ID
# Clave privada PEM completa (PKCS#1 o PKCS#8), tal cual la genero Enable Banking.
EB_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nPON-AQUI-TU-CLAVE-PRIVADA\n-----END PRIVATE KEY-----"

# --- Auth de la app (multiusuario: cada usuario se registra con su email) ---
# Genera un secreto aleatorio, p.ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-largo
# Solo se usa una vez, en la migracion 0001 (alembic upgrade head), para crear
# el primer usuario preservando tu contraseña de antes de multiusuario. Tras
# esa migracion no hace falta mantenerla. Genera un hash con:
# python -c "from app.security import hash_password; print(hash_password('tu-contraseña'))"
APP_PASSWORD_HASH=$2b$12$reemplaza-esto-con-el-hash-generado
# Email del usuario que se crea en esa migracion (opcional, por defecto el del propietario original).
MIGRATION_OWNER_EMAIL=tu-email@ejemplo.com

# --- URLs publicas ---
# Origen exacto de la PWA (para CORS).
FRONTEND_ORIGIN=http://localhost:3000
# URL publica de este backend (para construir el redirect_url que se registra
# en Enable Banking: {BACKEND_PUBLIC_URL}/api/banks/callback).
BACKEND_PUBLIC_URL=http://localhost:8000
